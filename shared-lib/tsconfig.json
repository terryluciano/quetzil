{
	"compilerOptions": {
		"target": "ES2020",
		"module": "CommonJS",
		"moduleResolution": "node",
		"outDir": "./dist",
		"baseUrl": "./",
		"rootDir": "./src",
		"skipLibCheck": true,
		"incremental": true,
		"composite": true,
		"strict": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true
	},
	"exclude": ["node_modules", "dist"],
	"include": ["src/**/*.ts"]
}
